# VisionClaw environment reference.
#
# Every variable below is read by the code in this repository; nothing here is
# a placeholder for a feature that does not exist. Blank or commented means
# "not configured": that capability then reports itself as not set up.
#
# Where it goes:
#   - deploy/install.sh writes the answers you give it to ./.env (mode 600) and
#     the systemd services read that file. It is the easiest route.
#   - Running by hand: the gateway reads gateway/.env (cd gateway && npm start);
#     the voice worker reads its environment (see agent/main.py).
# Never commit a filled-in copy. .env files are gitignored.

# ---------------------------------------------------------------- Application
# The gateway: API, phone web app, employee runtime and tools.
PORT=8788
# Address to listen on. 127.0.0.1 keeps a laptop install off its network
# (deploy/local.sh sets it); unset, every interface.
# HOST=127.0.0.1
# Public https origin of the gateway. Required in production; must be https.
PUBLIC_BASE_URL=
# production turns on secure cookies and the https check above.
NODE_ENV=production
# Where the built phone app lives (defaults to ../web/dist beside the gateway).
# WEB_DIST_DIR=
# Requests per minute per client address on the employee API (default 240).
# API_RATE_LIMIT=240
# Tasks run at once across the gateway (1-99, default 2).
# RUN_CAPACITY=2

# ------------------------------------------------------ Database / Auth
# token:userId pairs, comma-separated. The token is the access code typed on
# the phone. Use long random tokens.
GATEWAY_TOKENS=
# Signs OAuth state for app connections. Required in production: at least 32
# random characters (for example: openssl rand -hex 32).
STATE_SECRET=
# Service token the voice worker uses to reach the gateway (same value on both).
GATEWAY_SERVICE_TOKEN=
# Store file for accounts and connected apps; its folder is the data folder.
STORE_PATH=./data/gateway-store.json
# Employee data (SQLite database, evidence, per-owner runtime homes).
# EMPLOYEE_DATA_DIR=
# EMPLOYEE_DB_PATH=
# New Google sign-ins may create an account (default true); false closes it.
# REGISTRATION_OPEN=true
# Google sign-in and Google app connections (OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --------------------------------------------------------------------- Gemini
# Realtime conversation. Read by the voice worker (agent/), not the gateway.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# GEMINI_VOICE=Puck
# QUICK_SEARCH_MODEL=gemini-3.5-flash-lite
# ATTACH_VIEW_MODE=auto
# Where the worker sends tasks: this gateway's URL.
GATEWAY_URL=
# The gateway also needs LIVEKIT_URL, LIVEKIT_API_KEY and LIVEKIT_API_SECRET to
# mint room tickets; without them voice is reported as not set up.

# ----------------------------------------------------------- Runtime choice
# Which engine carries out tasks: anthropic (default), hermes or claude.
# AGENT_RUNTIME=anthropic

# --------------------------------------------------------------------- Hermes
# Official Hermes runtime installed on the server.
# HERMES_CHECKOUT=/opt/hermes-agent
# HERMES_PYTHON=/opt/hermes-agent/.venv/bin/python
# Provider and model Hermes should use, if not its own configured default.
# HERMES_PROVIDER=
# HERMES_MODEL=
# HERMES_BASE_URL=
# HERMES_API_KEY=

# -------------------------------------------------------------- Codex / OpenAI
# Forwarded into the Hermes runtime for its OpenAI/Codex provider, and used by
# the voice worker's optional OpenAI Realtime engine.
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=

# ---------------------------------------------------- Other model providers
# Anthropic Managed Agents runtime (AGENT_RUNTIME=anthropic).
ANTHROPIC_API_KEY=
# AGENT_MODEL=claude-sonnet-5
# AGENT_EFFORT=medium
# QUICK_ANSWER_TIMEOUT_MS=30000
# MCP tools (server:tool, comma-separated) the Managed runtime may run without
# asking, because they only read.
# MANAGED_READ_TOOLS=
# Claude Code on your own Claude subscription (AGENT_RUNTIME=claude). Sign it in
# yourself with `claude auth login` as the service user; the gateway never sees
# that login. Only this account's tasks may run on it.
# CLAUDE_CODE_OWNER=owner
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_MODEL=
# Forwarded into the Hermes runtime when set.
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=

# ------------------------------------------------------------------------ MCP
# JSON file listing https MCP servers the employee may use.
# MCP_CONFIG_PATH=
# Hosted Google Workspace / Gmail MCP servers for the Managed Agents runtime.
# WORKSPACE_MCP_URL=
# GMAIL_MCP_URL=
# GOOGLE_GMAIL_CLIENT_ID=
# GOOGLE_GMAIL_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_DISABLED=
# NOTION_DISABLED=

# ---------------------------------------------------------- Browser / Computer
# Browserbase: a browser the employee drives step by step; you can watch it and
# take it over from the phone.
# BROWSERBASE_API_KEY=
# BROWSERBASE_PROJECT_ID=
# BROWSERBASE_API_BASE=https://api.browserbase.com
# Browser Use Cloud: the employee hands a whole browsing job to Browser Use.
# BROWSER_USE_API_KEY=
# BROWSER_USE_MODEL=
# BROWSER_USE_MAX_COST_USD=0.75
# BROWSER_USE_SCREEN_W=
# BROWSER_USE_SCREEN_H=
# BROWSER_USE_API_BASE=https://api.browser-use.com/api/v4
# Browsers open at once across the gateway (default 1).
# COMPUTER_CAPACITY=1
# BROWSER_POLL_MS=2000
# Extra https hosts the phone may frame a live view from, comma-separated.
# browser-use.com and browserbase.com are built in.
# BROWSER_LIVE_VIEW_HOSTS=
# Web search for the employee (Brave Search API by default).
# SEARCH_API_KEY=
# SEARCH_ENDPOINT=https://api.search.brave.com/res/v1/web/search

# ------------------------------------------------------------------------ SMS
# Twilio. Point your number's incoming-message webhook at
# ${PUBLIC_BASE_URL}/webhooks/sms/inbound; delivery updates need no setup.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
# TWILIO_API_BASE=https://api.twilio.com
# Which owner receives replies to each of your numbers, as JSON:
# COMMUNICATION_ROUTES={"+15550100000":"owner"}

# ---------------------------------------------------------------------- Voice
# Retell phone calls. Point its webhook at ${PUBLIC_BASE_URL}/webhooks/voice.
# RETELL_API_KEY=
# RETELL_FROM=
# RETELL_AGENT_ID=
# RETELL_API_BASE=https://api.retellai.com

# ---------------------------------------------------- Procurement / Supplier
# Each supplier is independent; a search asks every connected one at once.
# The endpoint is the one your partner entitlement grants (or your signing proxy).
# HOME_DEPOT_ENDPOINT=
# HOME_DEPOT_API_KEY=
# LOWES_ENDPOINT=
# LOWES_API_KEY=
# AMAZON_ENDPOINT=
# AMAZON_API_KEY=
# WALMART_ENDPOINT=
# WALMART_API_KEY=
# Local yards and specialty vendors, and field-mapping overrides (JSON file).
# Each supplier there names its own credential variable.
# SUPPLIER_CONFIG_PATH=
# SUPPLIER_TIMEOUT_MS=20000
# eBay is optional and off unless enabled.
# EBAY_ENABLED=false
# EBAY_CLIENT_ID=
# EBAY_CLIENT_SECRET=
# EBAY_MARKETPLACE=

# -------------------------------------------------------------------- Storage
# Evidence, uploads and the database live under the data folder above
# (EMPLOYEE_DATA_DIR, next to STORE_PATH by default). Mount a persistent
# volume there in production; there is no separate object store to configure.

# -------------------------------------------------------------- Observability
# Logs go to stdout; with deploy/install.sh read them with
# journalctl -u fieldagent (gateway) and -u fieldagent-voice (worker). Errors
# the employee API returns have secret values and secret-named fields redacted
# (gateway/src/employee/redact.ts). `bash deploy/doctor.sh` checks every
# configured service.
# DIAG=1 probes an OAuth provider directly when an app connection fails.
# DIAG=
