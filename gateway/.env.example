# Hosted runtime (AGENT_RUNTIME=anthropic, the default). Leave blank to use
# Hermes or Claude Code instead.
ANTHROPIC_API_KEY=
PORT=8788
# token:userId pairs, comma-separated. The token is the access code you type on
# the phone: make it long and random (for example: openssl rand -hex 24).
GATEWAY_TOKENS=
AGENT_MODEL=claude-sonnet-5
AGENT_EFFORT=medium
QUICK_ANSWER_TIMEOUT_MS=30000
STORE_PATH=./data/gateway-store.json

# App connections (OAuth -> per-user vault credential)
# Signs OAuth state. Required in production: at least 32 random characters
# (for example: openssl rand -hex 32).
STATE_SECRET=
PUBLIC_BASE_URL=https://your-gateway.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Which engine does the work: anthropic (default), hermes or claude.
# AGENT_RUNTIME=anthropic
# claude = Claude Code on your own Claude subscription. Sign it in yourself
# (claude auth login, as the user this gateway runs as); only this account's
# tasks may run on it.
# CLAUDE_CODE_OWNER=owner
# Extra hosts the phone may show a browser live view from (browser-use.com and
# browserbase.com are built in).
# BROWSER_LIVE_VIEW_HOSTS=

# Every variable the code reads, by category: ../.env.example
